---
import Base from "../layouts/Base.astro";
const faq: [string, string][] = [
  ["Does Hark work offline?", "Yes, completely, once the AI models are downloaded. Airplane mode is fine."],
  ["Is it really free?", "Yes. Hark is MIT-licensed open source. No tiers, no seats, no minute limits, no upsell."],
  ["How accurate is the transcription?", "The GPU tier uses Whisper large-v3-turbo, which is state of the art for English and most major languages. CPU tiers use smaller Whisper models and are still good; the AI cleanup pass repairs many of their mistakes."],
  ["Does a bot join my meeting?", "No. Hark records what your microphone hears and what the meeting app plays. Nobody in the call can tell."],
  ["Will my music or notifications end up in the recording?", "Not on Windows: you pick the meeting window before recording and Hark captures only that application's audio (plus your mic). Choose 'Everything playing' if you want all system audio. On macOS all system audio is recorded."],
  ["Can I see the transcript during the call?", "Yes. Open the recording from the Library while it runs: captions appear as people talk and running notes - topic, decisions, action items so far - update every minute or two. The full transcript with speaker names arrives when you stop."],
  ["How long does it take after the call?", "With the CUDA build about 10 minutes for an 88-minute call, everything included. On a CPU-only machine Hark measures each speech model's real speed and picks the best one that finishes within the recording's own length; speaker detection runs across all cores in parallel with transcription."],
  ["Can I import a recording I already have?", "Yes. Library > Import takes audio or video files (a phone voice memo, an old Zoom .mp4) and runs the same pipeline: transcript, speakers, summary, search."],
  ["Which apps are detected?", "Zoom, Microsoft Teams, Google Meet, Webex, Discord, Slack huddles, FaceTime and GoToMeeting by window. Everything else by audio activity (mic and speakers both live). You can add detection patterns in Settings, and the hotkey works anywhere."],
  ["Can I use it for in-person meetings?", "Yes. Start a recording manually; speaker identification works from the microphone alone."],
  ["How does it know who is speaking?", "pyannote segmentation splits the audio into speaker turns and TitaNet computes a voiceprint per speaker, all on your machine. Your own voice is recognised because it arrives through the microphone track. Name someone once and Hark will suggest their name next time; it never applies a name without you confirming."],
  ["What hardware do I need?", "Any 64-bit Windows 10/11 or macOS 13+ computer with 8 GB RAM. An NVIDIA GPU with 6 GB+ VRAM, or Apple Silicon, unlocks the larger models and makes everything several times faster."],
  ["How much disk space?", "Models: 1 to 7 GB depending on tier. Recordings: about 35 MB per hour of audio, plus roughly 300 to 600 MB per hour if you record screen video."],
  ["Can I use my own AI model?", "Yes. Point Hark at Ollama, LM Studio or any OpenAI-compatible server in Settings. Transcription still happens in Hark."],
  ["How do I move to a new computer?", "Export everything as a .hark bundle and import it on the other machine, or move the whole data folder."],
  ["Why is the installer unsigned?", "Code-signing certificates cost money the project doesn't have yet. Check the SHA-256 on the release page, or build from source."],
];
const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) };
---

<Base title="FAQ" description="Answers about Hark, the free open-source offline meeting recorder: accuracy, hardware, detection, speaker identification, privacy and moving your library." jsonLd={[faqLd]}>
  <section style="padding: 56px 0 24px; max-width: 760px;">
    <p class="eyebrow">FAQ</p>
    <h1>Questions people ask before installing</h1>
    <div style="margin-top: 24px;">
      {faq.map(([q, a]) => <details><summary>{q}</summary><p class="muted" style="margin-top: 8px;">{a}</p></details>)}
    </div>
  </section>
</Base>
