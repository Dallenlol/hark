{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hark",
  "version": "0.2.0",
  "identifier": "app.hark.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hark",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "popup",
        "title": "Hark",
        "url": "index.html?window=popup",
        "width": 380,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      },
      {
        "label": "recordbar",
        "title": "Hark recording",
        "url": "index.html?window=recordbar",
        "width": 560,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Hark/**",
          "$HOME/Library/Application Support/Hark/**",
          "$APPDATA/**"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/hark-diarize"
    ],
    "category": "Productivity",
    "shortDescription": "Local-only meeting recorder with private AI",
    "longDescription": "Hark records your meetings locally, transcribes them with speaker labels and lets you chat with a private, on-device AI about them. Nothing leaves your computer.",
    "resources": {
      "resources/*": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "publisher": "Hark contributors",
    "homepage": "https://dallenlol.github.io/hark",
    "copyright": "MIT License",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMjdGQUU3QjAxRkM2QkIKUldTN3hoK3c1L29uMDRvWHZGM0VYQjJkTVN5OTBnTTZzSVBkdkZQZjBQR3Jrd2NHOU9RVy9xU2QK",
      "endpoints": [
        "https://github.com/Dallenlol/hark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
